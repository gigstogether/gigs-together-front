# Full reference: docs/configuration/ENVIRONMENT.md
# NEXT_PUBLIC_* values are public and embedded during the build; never put secrets here.

# Required for normal application use. Set both URLs before development or build.
# The API base URL must not include /v1; clients add versioned endpoint paths.
NEXT_PUBLIC_APP_API_BASE_URL=
NEXT_PUBLIC_APP_BASE_URL=

# Optional public links.
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# Optional feed settings: page size and calendar query stale time (milliseconds).
NEXT_PUBLIC_FEED_PAGE_SIZE=
NEXT_PUBLIC_FEED_CALENDAR_DATES_STALE_TIME_MS=
NEXT_PUBLIC_SUGGEST_GIG_ENABLED=

# Optional auth UI; enabling it requires the public BotFather Web Login Client ID.
# The Client ID must match backend TELEGRAM_OIDC_CLIENT_ID.
NEXT_PUBLIC_AUTH_ENABLED=
# Public BotFather Web Login Client ID.
NEXT_PUBLIC_TELEGRAM_OIDC_CLIENT_ID=
NEXT_PUBLIC_TELEGRAM_CLIENT_PROFILE_STORAGE_KEY=

# Optional GoatCounter count endpoint. Unset disables analytics; production sites only.
NEXT_PUBLIC_GOATCOUNTER_ENDPOINT=

# Server-only branding and metadata.
BRAND_NAME=
SITE_PREVIEW_TITLE=
SITE_PREVIEW_DESCRIPTION=

# Server-only secrets; each must match the corresponding backend value.
FEED_REVALIDATE_SECRET=
TRANSLATIONS_REVALIDATE_SECRET=

# Optional server translation cache interval (seconds).
TRANSLATIONS_REVALIDATE_SECONDS=
# Optional eager-loaded poster count on the initial feed page.
EAGER_INITIAL_POSTER_COUNT=

# Development server only: comma-separated hostnames without protocol or port.
ALLOWED_DEV_ORIGINS=
